{
  "id": "atl.tui.nano",
  "name": "GNU nano",
  "type": "tui",
  "api_version": "1.0",
  "version": "0.1.0",
  "description": "Interactive nano helper with safe save, exit, insert, and prompt-state guidance.",
  "logo": "logo.txt",
  "entry": {
    "commands": "commands.json",
    "prompts": "prompts.md"
  },
  "supports": ["ssh", "telnet", "local_shell"],
  "permissions": ["read_terminal", "suggest_commands", "parse_output"],
  "safe_by_default": true,
  "ui": {
    "badge_bg": "#7a3e9d",
    "badge_fg": "#ffffff"
  }
}
